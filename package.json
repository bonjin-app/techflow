{
  "name": "techflow",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "pnpm gen && next dev",
    "build": "pnpm validate && pnpm gen && next build",
    "start": "next start",
    "lint": "eslint",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "e2e": "playwright test",
    "e2e:ui": "playwright test --ui",
    "validate": "tsx scripts/validate-content.ts && tsx scripts/check-intent.ts",
    "check:intent": "tsx scripts/check-intent.ts",
    "gen:index": "tsx scripts/gen-search-index.ts",
    "check:links": "tsx scripts/check-links.ts",
    "check:build": "tsx scripts/check-build.ts",
    "link:labels": "tsx scripts/link-labels.ts",
    "gaps": "tsx scripts/find-gaps.ts",
    "gen:api": "tsx scripts/gen-api.ts",
    "gen": "pnpm gen:index && pnpm gen:api"
  },
  "dependencies": {
    "d3-force": "^3.0.0",
    "geist": "^1.7.2",
    "gray-matter": "^4.0.3",
    "next": "16.3.5",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "react-markdown": "^10.1.0",
    "remark-gfm": "^4.0.1"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.13.0",
    "@playwright/test": "^1.63.0",
    "@tailwindcss/postcss": "^4",
    "@types/d3-force": "^3.0.10",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "axe-core": "^4.13.0",
    "eslint": "^9",
    "eslint-config-next": "16.3.4",
    "tailwindcss": "^4",
    "tsx": "^4.23.13",
    "typescript": "^5",
    "vitest": "^5.0.1"
  },
  "packageManager": "pnpm@11.10.0"
}
